NODE_ENV=development
PORT=5000

FRONTEND_ORIGIN=http://localhost:3000

# Database Configuration (MongoDB)
# Leave empty for local development without database, or provide standard MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/snapfreetools

# Document Storage Configuration
# Options: 'local' (development/default) | 's3' (production AWS S3 or Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/documents

# S3 / Cloudflare R2 Configuration (Required only when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=snapfreetools-documents-prod
S3_ACCESS_KEY_ID=your-s3-or-r2-access-key
S3_SECRET_ACCESS_KEY=your-s3-or-r2-secret-key
S3_FORCE_PATH_STYLE=false

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-app-password

CONTACT_RECEIVER_EMAIL=admin@yourdomain.com
CONTACT_FROM_NAME=SnapFreeTools Contact
CONTACT_FROM_EMAIL=your-email@gmail.com

CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX_REQUESTS=5

# Word to PDF Configuration
WORD_TO_PDF_ENABLED=false
WORD_TO_PDF_MAX_FILE_SIZE_MB=10
WORD_TO_PDF_TIMEOUT_MS=60000
WORD_TO_PDF_RATE_LIMIT_WINDOW_MINUTES=15
WORD_TO_PDF_RATE_LIMIT_MAX_REQUESTS=5
WORD_TO_PDF_MAX_CONCURRENT_CONVERSIONS=2
WORD_TO_PDF_TEMP_DIR=
LIBREOFFICE_PATH=


