NODE_ENV=development
PORT=5000

FRONTEND_ORIGIN=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-app-password

